# ==============================================================================
# Trading-Bot Environment Configuration Template
# Copy this file to .env and populate with your live credentials/settings.
# DO NOT commit the .env file containing live secrets to version control.
# ==============================================================================

# --- Telegram Bot Configuration ---
# Create your bot via @BotFather on Telegram to obtain the token
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID or authorized chat ID
TELEGRAM_CHAT_ID=
# Enable or disable Telegram dispatching (true / false)
TELEGRAM_ENABLED=true
# Optional SOCKS5 or HTTP proxy URL for Telegram WebRequests (e.g., socks5h://127.0.0.1:1080)
TELEGRAM_PROXY=

# --- MetaTrader 5 Bridge Socket IPC ---
# Local host and port for EA <-> Python zero-dependency TCP socket
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=5555

# --- Execution & Account Risk Profile ---
# Operational mode: DEMO, LIVE, or PROP
EXECUTION_MODE=DEMO
